{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Business Tracker record",
  "description": "One record = one announced, piloted or deployed use of AI at a large company, or one AI programme investment. Company universe: the Fortune 500 plus the major global technology vendors.",
  "type": "object",
  "required": ["id", "company", "sector", "industry", "title", "status", "event_date", "source_url", "digest_line"],
  "properties": {
    "id": { "type": "string", "description": "Stable unique slug. Used for dedup." },
    "company": { "type": "string", "description": "The specific brand or entity, e.g. Walmart, Isybank." },
    "parent_group": { "type": "string", "description": "Parent group if the company is a subsidiary or brand. Empty string if it is itself the top-level group." },
    "sector": {
      "type": "string",
      "enum": ["Financial", "Retail & Consumer", "Health", "Technology", "Telecom & Media", "Energy & Resources", "Industrial", "Transport", "Services & Other"]
    },
    "industry": {
      "type": "string",
      "description": "The granular industry. Must belong to the chosen sector; see SECTORS in scripts/ingest.py.",
      "enum": [
        "Banks", "Payments", "Fintech", "Insurance", "Asset & Wealth Management", "Exchanges & Market Infrastructure",
        "Retail & E-commerce", "Consumer Products", "Food & Beverage", "Restaurants", "Apparel & Luxury",
        "Pharma & Biotech", "Healthcare Providers", "Health Insurers", "Medical Devices",
        "Big Tech & Cloud", "Software & SaaS", "Semiconductors & Hardware", "IT Services & Consulting",
        "Telecom", "Media & Entertainment", "Advertising & Marketing", "Gaming",
        "Oil & Gas", "Utilities & Power", "Renewables", "Metals & Mining", "Chemicals",
        "Industrial Manufacturing", "Aerospace & Defense", "Automotive", "Construction & Engineering",
        "Airlines", "Logistics & Delivery", "Rail & Shipping",
        "Professional Services", "Real Estate", "Education", "Agriculture", "Hospitality & Travel"
      ]
    },
    "entity_type": { "type": "string", "enum": ["Large enterprise", "Tech vendor"] },
    "fortune500_rank": { "type": ["integer", "null"], "description": "Fortune 500 rank where applicable, otherwise null." },
    "country": { "type": "string", "description": "HQ country." },
    "region": { "type": "string", "enum": ["North America", "Europe", "UK & Ireland", "Asia-Pacific", "MENA", "Latin America"] },
    "business_area": {
      "type": "string",
      "description": "Where in the company it was deployed.",
      "enum": ["Customer Service", "Marketing & Sales", "Supply Chain", "Manufacturing & Field Ops", "Engineering & IT", "Finance", "HR", "Legal & Compliance", "R&D", "Risk & Safety", "Product", "Cross-functional"]
    },
    "record_type": { "type": "string", "enum": ["Use case", "Investment / programme", "Partnership", "Product launch", "Org / leadership"] },
    "ai_type": { "type": "string", "enum": ["Generative AI", "Agentic AI", "Predictive ML", "NLP", "Computer Vision", "Conversational AI", "Robotics", "Other"] },
    "title": { "type": "string", "description": "Short headline, <= 110 chars." },
    "description": { "type": "string", "description": "1-3 sentence summary." },
    "vendor": { "type": "string", "description": "Tech partner or model provider, if any." },
    "outcome": { "type": "string", "description": "What was measured or stated. Not disclosed where nothing was reported." },
    "metric": { "type": "string", "description": "Short scannable metric, empty if none was reported." },
    "investment_amount": { "type": "string", "description": "Stated figure as text. Empty if none." },
    "status": { "type": "string", "enum": ["Announced", "Pilot", "Deployed", "Scaling", "Investment"] },
    "digest_line": { "type": "string", "description": "One standalone sentence under ~160 chars for the weekly digest." },
    "title_ru": { "type": "string" },
    "description_ru": { "type": "string" },
    "outcome_ru": { "type": "string" },
    "digest_line_ru": { "type": "string" },
    "event_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Not earlier than 2026-10-01." },
    "source_name": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "source_tier": { "type": "string", "enum": ["primary", "news", "secondary"] },
    "source_channel": { "type": "string", "description": "For example newsroom, investor release, trade press." },
    "confidence": { "type": "string", "enum": ["high", "med", "low"] },
    "added_at": { "type": "string" }
  }
}
